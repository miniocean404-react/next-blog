    "unist-util-visit": "^5.0.0",
    "vercel": "50.1.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{css,scss}": [
      "pnpm format",
      "git add ."
    ],
    "*.ts?(x)": [
      "pnpm format",
      "git add ."
    ]
  },
  "browserslist": [
    "chrome 64",
    "edge 79",
    "firefox 67",
    "opera 51",
    "safari 12"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@opentelemetry/sdk-trace-base"
      ]
    }
  }
}
